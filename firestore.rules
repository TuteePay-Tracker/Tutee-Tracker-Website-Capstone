rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;  
    }
    
    // Helper function to check if user owns the data
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Helper: read the caller's own profile document.
    function callerDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Helper: active Super Admin (manually provisioned role).
    function isSuperAdmin() {
      return isAuthenticated()
        && callerDoc().data.role == 'super_admin'
        && callerDoc().data.status == 'active';
    }

    // Active tutor. Deactivated tutors keep their profile but may not write any
    // tutor-owned data (parent management, activity logging, etc.).
    function isTutorCaller() {
      return isAuthenticated()
        && callerDoc().data.role == 'tutor'
        && (!callerDoc().data.keys().hasAny(['status'])
          || callerDoc().data.status == 'active');
    }

    function isParentCaller() {
      return isAuthenticated() && callerDoc().data.role == 'parent';
    }

    // Helper: owner updates may not touch privileged/immutable fields.
    function isSafeOwnerUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'status', 'createdByTutorId', 'createdAt']);
    }

    // Helper: check if the caller is linked to a specific tutee of this tutor
    // via the tutee document's parentId field (the source the mobile app's
    // tuteeService.subscribeAll already uses to list a parent's tutees).
    // This is the reliable link check — it does NOT depend on the parent
    // profile's linkedStudentIds/createdByTutorId, which can be missing or stale.
    function isLinkedToTutee(userId, tuteeId) {
      return request.auth != null &&
             tuteeId != null &&
             exists(/databases/$(database)/documents/users/$(userId)/tutees/$(tuteeId)) &&
             get(/databases/$(database)/documents/users/$(userId)/tutees/$(tuteeId)).data.parentId == request.auth.uid;
    }

    // Helper: check if caller is a parent linked to this tutor and this specific tutee.
    // Accepts BOTH link mechanisms so parents keep access whether they are linked
    // through the profile's linkedStudentIds or through the tutee doc's parentId.
    function isParentOfTutee(userId, tuteeId) {
      return isAuthenticated() && (
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'parent' &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.createdByTutorId == userId &&
         tuteeId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedStudentIds)
        ||
        isLinkedToTutee(userId, tuteeId)
      );
    }

    function isValidTutorProvisionBySuperAdmin() {
      let data = request.resource.data;
      return isSuperAdmin()
        && data.keys().hasAll(['name', 'email', 'role', 'status', 'mustChangePassword', 'createdAt'])
        && data.keys().hasOnly(['name', 'email', 'role', 'status', 'mustChangePassword', 'createdAt', 'contactNumber', 'photoUrl'])
        && data.role == 'tutor'
        && data.status == 'active'
        && data.mustChangePassword == true
        && data.name is string && data.name.size() > 0
        && data.email is string && data.email.size() > 0
        && data.createdAt is string
        && (!data.keys().hasAny(['contactNumber']) || data.contactNumber is string)
        && (!data.keys().hasAny(['photoUrl']) || data.photoUrl is string);
    }

    function isValidUserCreate() {
      let data = request.resource.data;
      return data.keys().hasAll(['name', 'email', 'role', 'createdAt'])
        && (data.role == 'tutor' || data.role == 'parent')
        && data.name is string && data.name.size() > 0
        && data.email is string && data.email.size() > 0
        && data.createdAt is string;
    }

    function isValidParentPortalCreate() {
      let data = request.resource.data;
      // Required fields must all be present
      return data.keys().hasAll(['name', 'email', 'role', 'mustChangePassword', 'linkedStudentIds', 'createdAt'])
        // All extra fields must be from the allowed set (including optional createdByTutorId and contactNumber)
        && data.keys().hasOnly(['name', 'email', 'role', 'mustChangePassword', 'linkedStudentIds', 'createdAt', 'createdByTutorId', 'contactNumber'])
        && data.role == 'parent'
        && data.name is string && data.name.size() > 0
        && data.email is string && data.email.size() > 0
        && data.mustChangePassword == true
        && data.linkedStudentIds is list
        && data.createdAt is string
        && (!data.keys().hasAny(['contactNumber']) || (data.contactNumber is string && data.contactNumber.size() > 0))
        && (!data.keys().hasAny(['createdByTutorId']) || data.createdByTutorId is string);
    }

    // User profile documents
    match /users/{userId} {
      // Super Admin may only toggle a tutor account between active and inactive.
      // Role and every other profile field remain immutable through this path.
      function isValidTutorStatusUpdateBySuperAdmin() {
        let data = request.resource.data;
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return isSuperAdmin()
          && !isOwner(userId)
          && resource.data.role == 'tutor'
          && data.role == 'tutor'
          && changed.hasOnly(['status'])
          && (data.status == 'active' || data.status == 'inactive');
      }

      function isValidParentUserUpdateByOwner() {
        let data = request.resource.data;
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return resource.data.role == 'parent'
          && data.role == 'parent'
          && changed.hasOnly([
            'mustChangePassword', 'name', 'contactNumber', 'photoUrl', 'tempPassword'
          ]);
      }

      function isValidParentUserUpdateByTutor() {
        let data = request.resource.data;
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        // Only tutors may re-link parents, only linking fields may change, and a
        // parent may only be linked by its existing tutor (or claimed when unowned).
        return isTutorCaller()
          && !isOwner(userId)
          && resource.data.role == 'parent'
          && data.role == 'parent'
          && changed.hasOnly(['linkedStudentIds', 'createdByTutorId'])
          && (
            (resource.data.keys().hasAny(['createdByTutorId'])
              && resource.data.createdByTutorId == request.auth.uid)
            || (!resource.data.keys().hasAny(['createdByTutorId'])
              && data.createdByTutorId == request.auth.uid)
          );
      }

      function isValidOwnedParentUpdate() {
        let data = request.resource.data;
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        // Owning tutors may refresh a parent's profile or rotate a temp password.
        // Role, status, and ownership remain immutable here.
        return isTutorCaller()
          && !isOwner(userId)
          && resource.data.role == 'parent'
          && resource.data.createdByTutorId == request.auth.uid
          && data.role == 'parent'
          && data.createdByTutorId == request.auth.uid
          && changed.hasOnly([
            'name', 'email', 'contactNumber', 'photoUrl',
            'mustChangePassword', 'tempPassword', 'linkedStudentIds', 'createdAt'
          ]);
      }

      // Allow authenticated users to read user profiles (parent linking, parent list)
      allow read: if isAuthenticated();

      // Users create their own profile on signup (e.g. self-signups if allowed)
      allow create: if isAuthenticated() && isOwner(userId) && isValidUserCreate();

      // Super Admin provisions tutor accounts
      allow create: if isAuthenticated() && userId != request.auth.uid && isSuperAdmin() && isValidTutorProvisionBySuperAdmin();

      // Tutor creates a parent portal account (writes to the new parent's uid).
      // We verify the writer is an active tutor, is writing for a DIFFERENT uid,
      // and that the data matches the parent portal schema OR is restored by the
      // tutor who created it.
      allow create: if isAuthenticated() && userId != request.auth.uid && isTutorCaller() && (
        isValidParentPortalCreate()
        || (request.resource.data.role == 'parent'
            && request.resource.data.createdByTutorId == request.auth.uid)
      );

      // Users update their own profile. Role/status/ownership fields are immutable.
      allow update: if isAuthenticated() && isOwner(userId) && (
        (resource.data.role == 'tutor' && isSafeOwnerUpdate())
        || (resource.data.role == 'parent' && isValidParentUserUpdateByOwner())
        || (!resource.data.keys().hasAny(['role']) && isSafeOwnerUpdate())
      );

      // Tutor updates parent linkedStudentIds / createdByTutorId when linking students,
      // or refreshes a parent profile / temp password for a parent they own.
      allow update: if isAuthenticated() && !isOwner(userId) && (
        isValidParentUserUpdateByTutor()
        || isValidOwnedParentUpdate()
      );

      // Super Admin activates or deactivates a tutor (status field only).
      allow update: if isAuthenticated() && isValidTutorStatusUpdateBySuperAdmin();

      // Allow owner or the tutor who created the parent account to delete it.
      // Super Admin may permanently delete tutor profiles; the relay also
      // performs this with the Admin SDK after re-authorizing the caller.
      allow delete: if isAuthenticated() && (
        isOwner(userId)
        || (resource.data.role == 'parent' && resource.data.createdByTutorId == request.auth.uid)
        || (!isOwner(userId) && isSuperAdmin() && resource.data.role == 'tutor')
      );

      // TUTEES subcollection
      match /tutees/{tuteeId} {
        // Validate tutee data structure
        function isValidTutee() {
          let data = request.resource.data;
          return data.keys().hasAll(['firstName', 'surname', 'subject', 'ratePerSession', 'schedule', 'totalSessions', 'totalPaid', 'balance', 'createdAt', 'updatedAt'])
            && data.firstName is string && data.firstName.size() > 0
            && data.surname is string && data.surname.size() > 0
            && data.subject is string && data.subject.size() > 0
            && data.ratePerSession is number && data.ratePerSession >= 0
            && (data.schedule is list || data.schedule is string)
            && data.totalSessions is number && data.totalSessions >= 0
            && data.totalPaid is number && data.totalPaid >= 0
            && data.balance is number
            && data.createdAt is timestamp
            && data.updatedAt is timestamp
            // Custom modification: Safely handles optional, null, timestamp, or string variants of lastPaymentDate
            && (!data.keys().hasAny(['lastPaymentDate']) || data.lastPaymentDate == null || data.lastPaymentDate is timestamp || data.lastPaymentDate is string)
            // School-year fields (optional, enforced by the app)
            && (!data.keys().hasAny(['schoolYears']) || data.schoolYears is list)
            && (!data.keys().hasAny(['archivedForYears']) || data.archivedForYears is list)
            && (!data.keys().hasAny(['totalsByYear']) || data.totalsByYear is map);
        }

        function isLinkingParentOnly() {
          let changed = request.resource.data.diff(resource.data).affectedKeys();
          return changed.hasOnly(['parentId'])
            || changed.hasOnly(['parentId', 'updatedAt']);
        }

        // Users can read their own tutees, parents can read if linked, Super Admin can monitor
        allow read: if isAuthenticated() && (isOwner(userId) || (resource != null && resource.data.parentId == request.auth.uid) || isSuperAdmin());

        allow delete: if isAuthenticated() && isOwner(userId);

        // Users can create tutees  
        allow create: if isAuthenticated() && isOwner(userId);

        // Users can update tutees
        allow update: if isAuthenticated() && isOwner(userId);
      }
      
      // PAYMENTS subcollection
      match /payments/{paymentId} {
        // Validate payment data structure
        function isValidPayment() {
          let data = request.resource.data;
          return data.keys().hasAll(['tuteeId', 'tuteeName', 'amount', 'sessionsCovered', 'paymentMethod', 'paymentDate', 'createdAt', 'updatedAt'])
            && data.tuteeId is string && data.tuteeId.size() > 0
            && data.tuteeName is string && data.tuteeName.size() > 0
            && data.amount is number && data.amount >= 0
            && data.sessionsCovered is number && data.sessionsCovered >= 0
            && data.paymentMethod is string
            && data.paymentDate is string
            && data.createdAt is timestamp
            && data.updatedAt is timestamp
            && (!data.keys().hasAny(['status']) || data.status is string)
            && (!data.keys().hasAny(['proofUrl']) || data.proofUrl is string)
            && (!data.keys().hasAny(['month']) || data.month is string)
            && (!data.keys().hasAny(['schoolYear']) || data.schoolYear is string);
        }

        // Tutor reads own payments; linked parent can read too; Super Admin can monitor
        allow read: if isAuthenticated() && (
          isOwner(userId) || 
          isParentOfTutee(userId, resource.data.tuteeId) ||
          isSuperAdmin()
        );
        allow delete: if isAuthenticated() && isOwner(userId);

        // Users can create payments (tutors, or parents with valid data)
        allow create: if isAuthenticated() && (
          isOwner(userId) || 
          (isParentOfTutee(userId, request.resource.data.tuteeId) && isValidPayment())
        );

        // Users can update payments
        allow update: if isAuthenticated() && isOwner(userId);
      }
      
      // SESSIONS subcollection
      match /sessions/{sessionId} {
        // Validate session data structure
        function isValidSession() {
          let data = request.resource.data;
          return data.keys().hasAll(['tuteeId', 'tuteeName', 'sessionDate', 'duration', 'status', 'createdAt', 'updatedAt'])
            && data.tuteeId is string && data.tuteeId.size() > 0
            && data.tuteeName is string && data.tuteeName.size() > 0
            && data.sessionDate is string
            && data.duration is number && data.duration > 0
            && data.status is string
            && data.createdAt is timestamp
            && data.updatedAt is timestamp
            && (!data.keys().hasAny(['schoolYear']) || data.schoolYear is string);
        }

        // Tutor reads own sessions; linked parent can read too; Super Admin can monitor
        allow read: if isAuthenticated() && (
          isOwner(userId) || 
          isParentOfTutee(userId, resource.data.tuteeId) ||
          isSuperAdmin()
        );
        allow delete: if isAuthenticated() && isOwner(userId);

        // Users can create sessions
        allow create: if isAuthenticated() && isOwner(userId);

        // Users can update sessions
        allow update: if isAuthenticated() && isOwner(userId);
      }

      // PAYMENT RECORDS subcollection (day-based payments)
      match /paymentRecords/{recordId} {
        function isValidPaymentRecord() {
          let data = request.resource.data;
          return data.keys().hasAll(['tuteeId', 'tuteeName', 'month', 'dayPayments', 'totalDue', 'totalPaid', 'totalBalance', 'lastUpdated', 'createdAt'])
            && data.tuteeId is string
            && data.tuteeName is string
            && data.month is string
            && data.dayPayments is list
            && data.totalDue is number
            && data.totalPaid is number
            && data.totalBalance is number
            && data.lastUpdated is timestamp
            && data.createdAt is timestamp
            && (!data.keys().hasAny(['parentId']) || data.parentId == null || data.parentId is string)
            && (!data.keys().hasAny(['tutorId']) || data.tutorId is string)
            && (!data.keys().hasAny(['schoolYear']) || data.schoolYear is string);
        }
        // Allow read if tutor owner OR parent of tutee OR Super Admin
        allow read: if isAuthenticated() && (
          isOwner(userId) || 
          isParentOfTutee(userId, resource.data.tuteeId) ||
          (resource != null && resource.data.keys().hasAny(['parentId']) && resource.data.parentId == request.auth.uid) ||
          isSuperAdmin()
        );
        allow create, update: if isAuthenticated() && isOwner(userId);
        allow delete: if isAuthenticated() && isOwner(userId);
      }

      // PAYMENT TRANSACTIONS subcollection
      match /paymentTransactions/{transactionId} {
        function isValidTransaction() {
          let data = request.resource.data;
          return data.keys().hasAll(['tuteeId', 'tuteeName', 'paymentDate', 'daysPaid', 'totalAmount', 'paymentMethod', 'createdAt'])
            && data.tuteeId is string
            && data.tuteeName is string
            && data.paymentDate is string
            && data.daysPaid is list
            && data.totalAmount is number
            && data.paymentMethod is string
            && data.createdAt is timestamp
            && (!data.keys().hasAny(['month']) || data.month is string)
            && (!data.keys().hasAny(['schoolYear']) || data.schoolYear is string)
            && (!data.keys().hasAny(['paymentId']) || data.paymentId is string)
            && (!data.keys().hasAny(['notes']) || data.notes is string);
        }
        // Allow read if tutor owner OR parent of tutee OR Super Admin
        allow read: if isAuthenticated() && (
          isOwner(userId) || 
          isParentOfTutee(userId, resource.data.tuteeId) ||
          isSuperAdmin()
        );
        allow create, update: if isAuthenticated() && isOwner(userId);
        allow delete: if isAuthenticated() && isOwner(userId);
      }

      // MAKE-UP CREDITS subcollection (credits earned from absences)
      match /makeUpCredits/{creditId} {
        function isValidMakeUpCredit() {
          let data = request.resource.data;
          return data.keys().hasAll([
              'tuteeId', 'tuteeName', 'sourceDate', 'sourceMonth',
              'durationMinutes', 'status', 'createdAt', 'updatedAt'
            ])
            && data.tuteeId is string && data.tuteeId.size() > 0
            && data.tuteeName is string
            && data.sourceDate is string && data.sourceDate.size() == 10
            && data.sourceMonth is string && data.sourceMonth.size() == 7
            && data.durationMinutes is number && data.durationMinutes > 0
            && data.status in ['pending', 'scheduled', 'completed', 'reversed']
            && data.createdAt is timestamp
            && data.updatedAt is timestamp
            && (!data.keys().hasAny(['targetMonth']) || data.targetMonth is string)
            && (!data.keys().hasAny(['scheduledDate']) || data.scheduledDate is string)
            && (!data.keys().hasAny(['startTime']) || data.startTime is string)
            && (!data.keys().hasAny(['endTime']) || data.endTime is string)
            && (!data.keys().hasAny(['attendanceRecordId']) || data.attendanceRecordId is string)
            && (!data.keys().hasAny(['completedAt']) || data.completedAt is string)
            && (!data.keys().hasAny(['schoolYear']) || data.schoolYear is string)
            && (!data.keys().hasAny(['notes']) || data.notes is string);
        }

        allow read: if isAuthenticated() && (
          isOwner(userId) ||
          isParentOfTutee(userId, resource.data.tuteeId) ||
          isSuperAdmin()
        );
        allow create, update: if isAuthenticated() && isOwner(userId) && isValidMakeUpCredit();
        allow delete: if isAuthenticated() && isOwner(userId);
      }

      // PROGRESS REPORTS subcollection
      match /progressReports/{reportId} {
        function isValidProgressReport() {
          let data = request.resource.data;
          return data.keys().hasAll(['tuteeId', 'tutorId', 'date', 'subject', 'topicsCovered', 'performance', 'behavior', 'notes', 'createdAt'])
            && data.tuteeId is string
            && data.tutorId is string
            && data.date is string
            && data.subject is string
            && data.topicsCovered is string
            && data.performance is string
            && data.behavior is string
            && (!data.keys().hasAny(['assessmentScores']) || data.assessmentScores is list)
            && data.notes is string
            && data.createdAt is timestamp
            && (!data.keys().hasAny(['schoolYear']) || data.schoolYear is string);
        }

        // Allow read if tutor owner OR parent of tutee OR Super Admin
        allow read: if isAuthenticated() && (
          isOwner(userId) || 
          isParentOfTutee(userId, resource.data.tuteeId) ||
          isSuperAdmin()
        );
        allow create, update: if isAuthenticated() && isOwner(userId);
        allow delete: if isAuthenticated() && isOwner(userId);
      }

      // ANNOUNCEMENTS subcollection
      match /announcements/{announcementId} {
        function isValidAnnouncement() {
          let data = request.resource.data;
          return data.keys().hasAll(['title', 'content', 'priority', 'tutorId', 'createdAt', 'updatedAt'])
            && data.title is string && data.title.size() > 0
            && data.content is string && data.content.size() > 0
            && data.priority in ['low', 'medium', 'high']
            && data.tutorId == userId
            && data.createdAt is timestamp
            && data.updatedAt is timestamp
            && (!data.keys().hasAny(['schoolYear']) || data.schoolYear is string);
        }

        allow read: if isAuthenticated() && (
          isOwner(userId) ||
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'parent' &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.createdByTutorId == userId) ||
          isSuperAdmin()
        );

        allow create, update: if isAuthenticated() && isOwner(userId);
        allow delete: if isAuthenticated() && isOwner(userId);
      }

      // SUBJECTS subcollection (custom subjects for tutee forms)
      match /subjects/{subjectId} {
        function isValidSubject() {
          let data = request.resource.data;
          return data.keys().hasAll(['name', 'createdAt'])
            && data.name is string && data.name.size() > 0
            && data.createdAt is string && data.createdAt.size() > 0;
        }

        allow read: if isAuthenticated() && (
          isOwner(userId) ||
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'parent' &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.createdByTutorId == userId) ||
          isSuperAdmin()
        );
        allow delete: if isAuthenticated() && isOwner(userId);
        allow create, update: if isAuthenticated() && isOwner(userId);
      }

      // TOPICS subcollection (tutor-managed topics/learning areas per subject)
      match /topics/{topicId} {
        function isValidTopic() {
          let data = request.resource.data;
          return data.keys().hasAll(['subject', 'name', 'createdAt'])
            && data.subject is string && data.subject.size() > 0
            && data.name is string && data.name.size() > 0;
        }

        allow read: if isAuthenticated() && (
          isOwner(userId) ||
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'parent' &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.createdByTutorId == userId) ||
          isSuperAdmin()
        );
        allow create, update: if isAuthenticated() && isOwner(userId) && isValidTopic();
        allow delete: if isAuthenticated() && isOwner(userId);
      }

      // TOPIC PROGRESS subcollection (student progress per tutor-defined topic)
      match /topicProgress/{progressId} {
        allow read: if isAuthenticated() && (
          isOwner(userId) ||
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'parent' &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.createdByTutorId == userId) ||
          isSuperAdmin()
        );
        allow create, update: if isAuthenticated() && isOwner(userId);
        allow delete: if isAuthenticated() && isOwner(userId);
      }

      // ASSESSMENTS subcollection (tutor-managed student assessment records)
      match /assessments/{assessmentId} {
        function isValidAssessment() {
          let data = request.resource.data;
          return data.keys().hasAll(['tuteeId', 'tuteeName', 'subject', 'date', 'assessmentScores', 'topicsCovered', 'notes', 'score', 'remarks', 'createdAt', 'updatedAt'])
            && data.tuteeId is string
            && data.tuteeName is string
            && data.subject is string
            && data.date is string
            && data.assessmentScores is list
            && data.topicsCovered is string
            && data.notes is string
            && data.score is number && data.score >= 0 && data.score <= 100
            && data.remarks is string
            && data.createdAt is timestamp
            && data.updatedAt is timestamp
            && (!data.keys().hasAny(['recommendations']) || data.recommendations is string)
            && (!data.keys().hasAny(['schoolYear']) || data.schoolYear is string);
        }

        // Tutor reads/writes own assessments; linked parents and Super Admin can read too
        allow read: if isAuthenticated() && (
          isOwner(userId) ||
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'parent' &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.createdByTutorId == userId) ||
          isSuperAdmin()
        );
        allow create, update: if isAuthenticated() && isOwner(userId);
        allow delete: if isAuthenticated() && isOwner(userId);
      }

      // SCHOOL YEARS subcollection (tutor-maintained school year list)
      match /schoolYears/{yearId} {
        // A school year doc simply flags existence; the id is the "YYYY-YY" value.
        // The tutor (owner) maintains it; linked parents may read the list so
        // the mobile app's SchoolYearContext can watch the available years.
        allow read: if isAuthenticated() && (
          isOwner(userId) ||
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'parent' &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.createdByTutorId == userId) ||
          isSuperAdmin()
        );
        allow create: if isAuthenticated() && isOwner(userId)
          && request.resource.data.keys().hasOnly(['value', 'createdAt', 'source'])
          && (request.resource.data.createdAt is timestamp || request.resource.data.createdAt is string);
        allow update: if isAuthenticated() && isOwner(userId);
        allow delete: if isAuthenticated() && isOwner(userId);
      }

      // PUSH TOKENS subcollection (Expo push notification tokens)
      // Only the owner may modify them. Any authenticated user may read them
      // so tutors can look up a parent's tokens to deliver chat/payment pushes.
      match /pushTokens/{tokenId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && isOwner(userId);
        allow delete: if isAuthenticated() && isOwner(userId);
      }
    }

    // CHAT THREADS and MESSAGES
    match /chats/{chatId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.tutorId == request.auth.uid ||
        resource.data.parentId == request.auth.uid
      );

      allow update: if isAuthenticated() && (
        resource.data.tutorId == request.auth.uid ||
        resource.data.parentId == request.auth.uid
      );

      allow create: if isAuthenticated() && (
        request.resource.data.tutorId == request.auth.uid ||
        request.resource.data.parentId == request.auth.uid
      );

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/chats/$(chatId)).data.tutorId == request.auth.uid ||
          get(/databases/$(database)/documents/chats/$(chatId)).data.parentId == request.auth.uid
        );

        allow create: if isAuthenticated() && (
          get(/databases/$(database)/documents/chats/$(chatId)).data.tutorId == request.auth.uid ||
          get(/databases/$(database)/documents/chats/$(chatId)).data.parentId == request.auth.uid
        ) && request.resource.data.senderId == request.auth.uid;

        allow update: if isAuthenticated() && (
          get(/databases/$(database)/documents/chats/$(chatId)).data.tutorId == request.auth.uid ||
          get(/databases/$(database)/documents/chats/$(chatId)).data.parentId == request.auth.uid
        );

        allow delete: if isAuthenticated() && (
          get(/databases/$(database)/documents/chats/$(chatId)).data.tutorId == request.auth.uid ||
          get(/databases/$(database)/documents/chats/$(chatId)).data.parentId == request.auth.uid
        ) && resource.data.senderId == request.auth.uid;
      }
    }

    // AUDIT LOGS (immutable activity trail)
    match /audit_logs/{logId} {
      // Only the acting user may append a log, scoped to their own tutor account.
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userRole in ['tutor', 'parent', 'super_admin']
        && request.resource.data.actionType is string
        && request.resource.data.module is string
        && request.resource.data.description is string
        && request.resource.data.timestamp is timestamp
        && (
          ((isTutorCaller() || isSuperAdmin()) && request.resource.data.tutorId == request.auth.uid)
          || (isParentCaller() && request.resource.data.tutorId == callerDoc().data.createdByTutorId)
        );

      // Super Admin can monitor all activity; tutors can read their own trail only.
      allow read: if isSuperAdmin()
        || (isTutorCaller() && resource.data.tutorId == request.auth.uid);

      // Audit logs are append-only.
      allow update, delete: if false;
    }
  }
}