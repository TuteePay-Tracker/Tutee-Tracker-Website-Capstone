rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the data
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Helper: check if caller is a parent linked to this tutor and this specific tutee
    function isParentOfTutee(userId, tuteeId) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'parent' &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.createdByTutorId == userId &&
             tuteeId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedStudentIds;
    }

    function isValidUserCreate() {
      let data = request.resource.data;
      return data.keys().hasAll(['name', 'email', 'role', 'createdAt'])
        && (data.role == 'tutor' || data.role == 'parent')
        && data.name is string && data.name.size() > 0
        && data.email is string && data.email.size() > 0
        && data.createdAt is string;
    }

    function isValidParentPortalCreate() {
      let data = request.resource.data;
      // Required fields must all be present
      return data.keys().hasAll(['name', 'email', 'role', 'mustChangePassword', 'linkedStudentIds', 'createdAt'])
        // All extra fields must be from the allowed set (including optional createdByTutorId and contactNumber)
        && data.keys().hasOnly(['name', 'email', 'role', 'mustChangePassword', 'linkedStudentIds', 'createdAt', 'createdByTutorId', 'contactNumber'])
        && data.role == 'parent'
        && data.name is string && data.name.size() > 0
        && data.email is string && data.email.size() > 0
        && data.mustChangePassword == true
        && data.linkedStudentIds is list
        && data.createdAt is string
        && (!data.keys().hasAny(['contactNumber']) || (data.contactNumber is string && data.contactNumber.size() > 0))
        && (!data.keys().hasAny(['createdByTutorId']) || data.createdByTutorId is string);
    }

    function isValidParentUserUpdateByOwner() {
      let data = request.resource.data;
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.role == 'parent'
        && data.role == 'parent'
        && changed.hasOnly(['mustChangePassword', 'name', 'contactNumber', 'photoUrl']);
    }

    function isValidParentUserUpdateByTutor() {
      let data = request.resource.data;
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      // Do NOT call isTutor() here — that makes a nested Firestore read which
      // can itself fail with "Missing or insufficient permissions".
      // Instead require the writer is authenticated, is writing for a DIFFERENT uid,
      // the document is a parent, and only linking fields are being changed.
      return isAuthenticated()
        && resource.data.role == 'parent'
        && data.role == 'parent'
        && changed.hasOnly(['linkedStudentIds', 'createdByTutorId']);
    }
    
    // User profile documents
    match /users/{userId} {
      // Allow authenticated users to read user profiles (parent linking, parent list)
      allow read: if isAuthenticated();

      // Users create their own profile on signup
      allow create: if isAuthenticated() && isOwner(userId) && isValidUserCreate();

      // Tutor creates a parent portal account (writes to the new parent's uid).
      // We do NOT call isTutor() here because that performs a nested Firestore get()
      // which can itself return "Missing or insufficient permissions".
      // Instead, we verify the writer is authenticated, is writing for a DIFFERENT uid,
      // and that the data matches the parent portal schema OR is restored by the tutor who created it.
      allow create: if isAuthenticated() && userId != request.auth.uid && (
        isValidParentPortalCreate()
        || (request.resource.data.role == 'parent' && request.resource.data.createdByTutorId == request.auth.uid)
      );

      // Users update their own profile
      allow update: if isAuthenticated() && isOwner(userId) && (
        !resource.data.keys().hasAny(['role'])
        || resource.data.role == 'tutor'
        || (resource.data.role == 'parent' && isValidParentUserUpdateByOwner())
      );

      // Tutor updates parent linkedStudentIds / createdByTutorId when linking students or restoring backup
      allow update: if isAuthenticated() && !isOwner(userId) && (
        isValidParentUserUpdateByTutor()
        || (resource.data.role == 'parent' && resource.data.createdByTutorId == request.auth.uid && request.resource.data.role == 'parent' && request.resource.data.createdByTutorId == request.auth.uid)
      );

      // Allow owner or the tutor who created the parent account to delete it
      allow delete: if isAuthenticated() && (
        isOwner(userId)
        || (resource.data.role == 'parent' && resource.data.createdByTutorId == request.auth.uid)
      );

      // TUTEES subcollection
      match /tutees/{tuteeId} {
        // Validate tutee data structure
        function isValidTutee() {
          let data = request.resource.data;
          return data.keys().hasAll(['firstName', 'surname', 'subject', 'ratePerSession', 'schedule', 'totalSessions', 'totalPaid', 'balance', 'createdAt', 'updatedAt'])
            && data.firstName is string && data.firstName.size() > 0
            && data.surname is string && data.surname.size() > 0
            && data.subject is string && data.subject.size() > 0
            && data.ratePerSession is number && data.ratePerSession >= 0
            && (data.schedule is list || data.schedule is string)
            && data.totalSessions is number && data.totalSessions >= 0
            && data.totalPaid is number && data.totalPaid >= 0
            && data.balance is number
            && data.createdAt is timestamp
            && data.updatedAt is timestamp
            // Custom modification: Safely handles optional, null, timestamp, or string variants of lastPaymentDate
            && (!data.keys().hasAny(['lastPaymentDate']) || data.lastPaymentDate == null || data.lastPaymentDate is timestamp || data.lastPaymentDate is string);
        }

        function isLinkingParentOnly() {
          let changed = request.resource.data.diff(resource.data).affectedKeys();
          return changed.hasOnly(['parentId'])
            || changed.hasOnly(['parentId', 'updatedAt']);
        }

        // Users can read their own tutees, and parents can read if they are linked
        allow read: if isAuthenticated() && (isOwner(userId) || (resource != null && resource.data.parentId == request.auth.uid));

        allow delete: if isAuthenticated() && isOwner(userId);

        // Users can create tutees  
        allow create: if isAuthenticated() && isOwner(userId);

        // Users can update tutees
        allow update: if isAuthenticated() && isOwner(userId);
      }
      
      // PAYMENTS subcollection
      match /payments/{paymentId} {
        // Validate payment data structure
        function isValidPayment() {
          let data = request.resource.data;
          return data.keys().hasAll(['tuteeId', 'tuteeName', 'amount', 'sessionsCovered', 'paymentMethod', 'paymentDate', 'createdAt', 'updatedAt'])
            && data.tuteeId is string && data.tuteeId.size() > 0
            && data.tuteeName is string && data.tuteeName.size() > 0
            && data.amount is number && data.amount >= 0
            && data.sessionsCovered is number && data.sessionsCovered >= 0
            && data.paymentMethod is string
            && data.paymentDate is string
            && data.createdAt is timestamp
            && data.updatedAt is timestamp
            && (!data.keys().hasAny(['status']) || data.status is string)
            && (!data.keys().hasAny(['proofUrl']) || data.proofUrl is string)
            && (!data.keys().hasAny(['month']) || data.month is string);
        }

        // Tutor reads own payments; linked parent can read too (if parentId matches)
        allow read: if isAuthenticated() && (
          isOwner(userId) || 
          isParentOfTutee(userId, resource.data.tuteeId)
        );
        allow delete: if isAuthenticated() && isOwner(userId);

        // Users can create payments (tutors, or parents with valid data)
        allow create: if isAuthenticated() && (
          isOwner(userId) || 
          (isParentOfTutee(userId, request.resource.data.tuteeId) && isValidPayment())
        );

        // Users can update payments
        allow update: if isAuthenticated() && isOwner(userId);
      }
      
      // SESSIONS subcollection
      match /sessions/{sessionId} {
        // Validate session data structure
        function isValidSession() {
          let data = request.resource.data;
          return data.keys().hasAll(['tuteeId', 'tuteeName', 'sessionDate', 'duration', 'status', 'createdAt', 'updatedAt'])
            && data.tuteeId is string && data.tuteeId.size() > 0
            && data.tuteeName is string && data.tuteeName.size() > 0
            && data.sessionDate is string
            && data.duration is number && data.duration > 0
            && data.status is string
            && data.createdAt is timestamp
            && data.updatedAt is timestamp;
        }

        // Tutor reads own sessions; linked parent can read too (if parentId matches)
        allow read: if isAuthenticated() && (
          isOwner(userId) || 
          isParentOfTutee(userId, resource.data.tuteeId)
        );
        allow delete: if isAuthenticated() && isOwner(userId);

        // Users can create sessions
        allow create: if isAuthenticated() && isOwner(userId);

        // Users can update sessions
        allow update: if isAuthenticated() && isOwner(userId);
      }

      // PAYMENT RECORDS subcollection (day-based payments)
      match /paymentRecords/{recordId} {
        function isValidPaymentRecord() {
          let data = request.resource.data;
          return data.keys().hasAll(['tuteeId', 'tuteeName', 'month', 'dayPayments', 'totalDue', 'totalPaid', 'totalBalance', 'lastUpdated', 'createdAt'])
            && data.tuteeId is string
            && data.tuteeName is string
            && data.month is string
            && data.dayPayments is list
            && data.totalDue is number
            && data.totalPaid is number
            && data.totalBalance is number
            && data.lastUpdated is timestamp
            && data.createdAt is timestamp
            && (!data.keys().hasAny(['parentId']) || data.parentId == null || data.parentId is string)
            && (!data.keys().hasAny(['tutorId']) || data.tutorId is string);
        }
        // Allow read if tutor owner OR parent of tutee
        allow read: if isAuthenticated() && (
          isOwner(userId) || 
          isParentOfTutee(userId, resource.data.tuteeId) ||
          (resource != null && resource.data.keys().hasAny(['parentId']) && resource.data.parentId == request.auth.uid)
        );
        allow create, update: if isAuthenticated() && isOwner(userId);
        allow delete: if isAuthenticated() && isOwner(userId);
      }

      // PAYMENT TRANSACTIONS subcollection
      match /paymentTransactions/{transactionId} {
        function isValidTransaction() {
          let data = request.resource.data;
          return data.keys().hasAll(['tuteeId', 'tuteeName', 'paymentDate', 'daysPaid', 'totalAmount', 'paymentMethod', 'createdAt'])
            && data.tuteeId is string
            && data.tuteeName is string
            && data.paymentDate is string
            && data.daysPaid is list
            && data.totalAmount is number
            && data.paymentMethod is string
            && data.createdAt is timestamp
            && (!data.keys().hasAny(['month']) || data.month is string);
        }
        // Allow read if tutor owner OR parent of tutee
        allow read: if isAuthenticated() && (
          isOwner(userId) || 
          isParentOfTutee(userId, resource.data.tuteeId)
        );
        allow create, update: if isAuthenticated() && isOwner(userId);
        allow delete: if isAuthenticated() && isOwner(userId);
      }

      // PROGRESS REPORTS subcollection
      match /progressReports/{reportId} {
        function isValidProgressReport() {
          let data = request.resource.data;
          return data.keys().hasAll(['tuteeId', 'tutorId', 'date', 'subject', 'topicsCovered', 'performance', 'behavior', 'notes', 'createdAt'])
            && data.tuteeId is string
            && data.tutorId is string
            && data.date is string
            && data.subject is string
            && data.topicsCovered is string
            && data.performance is string
            && data.behavior is string
            && (!data.keys().hasAny(['assessmentScores']) || data.assessmentScores is list)
            && data.notes is string
            && data.createdAt is timestamp;
        }

        // Allow read if tutor owner OR parent of tutee
        allow read: if isAuthenticated() && (
          isOwner(userId) || 
          isParentOfTutee(userId, resource.data.tuteeId)
        );
        allow create, update: if isAuthenticated() && isOwner(userId);
        allow delete: if isAuthenticated() && isOwner(userId);
      }

      // ANNOUNCEMENTS subcollection
      match /announcements/{announcementId} {
        function isValidAnnouncement() {
          let data = request.resource.data;
          return data.keys().hasAll(['title', 'content', 'priority', 'tutorId', 'createdAt', 'updatedAt'])
            && data.title is string && data.title.size() > 0
            && data.content is string && data.content.size() > 0
            && data.priority in ['low', 'medium', 'high']
            && data.tutorId == userId
            && data.createdAt is timestamp
            && data.updatedAt is timestamp;
        }

        allow read: if isAuthenticated() && (
          isOwner(userId) ||
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'parent' &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.createdByTutorId == userId)
        );

        allow create, update: if isAuthenticated() && isOwner(userId);
        allow delete: if isAuthenticated() && isOwner(userId);
      }

      // SUBJECTS subcollection (custom subjects for tutee forms)
      match /subjects/{subjectId} {
        function isValidSubject() {
          let data = request.resource.data;
          return data.keys().hasAll(['name', 'createdAt'])
            && data.name is string && data.name.size() > 0
            && data.createdAt is string && data.createdAt.size() > 0;
        }

        allow read, delete: if isAuthenticated() && isOwner(userId);
        allow create, update: if isAuthenticated() && isOwner(userId);
      }

      // ASSESSMENTS subcollection (tutor-managed student assessment records)
      match /assessments/{assessmentId} {
        function isValidAssessment() {
          let data = request.resource.data;
          return data.keys().hasAll(['tuteeId', 'tuteeName', 'subject', 'date', 'assessmentScores', 'topicsCovered', 'notes', 'score', 'remarks', 'createdAt', 'updatedAt'])
            && data.tuteeId is string
            && data.tuteeName is string
            && data.subject is string
            && data.date is string
            && data.assessmentScores is list
            && data.topicsCovered is string
            && data.notes is string
            && data.score is number && data.score >= 0 && data.score <= 100
            && data.remarks is string
            && data.createdAt is timestamp
            && data.updatedAt is timestamp
            && (!data.keys().hasAny(['recommendations']) || data.recommendations is string);
        }

        // Tutor reads/writes own assessments; linked parents can read too
        allow read: if isAuthenticated() && (
          isOwner(userId) ||
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'parent' &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.createdByTutorId == userId)
        );
        allow create, update: if isAuthenticated() && isOwner(userId);
        allow delete: if isAuthenticated() && isOwner(userId);
      }

      // PUSH TOKENS subcollection (Expo push notification tokens)
      // Tokens are device-level secrets; only the owner may manage them.
      match /pushTokens/{tokenId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create: if isAuthenticated() && isOwner(userId);
        allow delete: if isAuthenticated() && isOwner(userId);
        allow update: if false;
      }
    }

    // CHAT THREADS and MESSAGES
    match /chats/{chatId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.tutorId == request.auth.uid ||
        resource.data.parentId == request.auth.uid
      );

      allow update: if isAuthenticated() && (
        resource.data.tutorId == request.auth.uid ||
        resource.data.parentId == request.auth.uid
      );

      allow create: if isAuthenticated() && (
        request.resource.data.tutorId == request.auth.uid ||
        request.resource.data.parentId == request.auth.uid
      );

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/chats/$(chatId)).data.tutorId == request.auth.uid ||
          get(/databases/$(database)/documents/chats/$(chatId)).data.parentId == request.auth.uid
        );

        allow create: if isAuthenticated() && (
          get(/databases/$(database)/documents/chats/$(chatId)).data.tutorId == request.auth.uid ||
          get(/databases/$(database)/documents/chats/$(chatId)).data.parentId == request.auth.uid
        ) && request.resource.data.senderId == request.auth.uid;

        allow update: if isAuthenticated() && (
          get(/databases/$(database)/documents/chats/$(chatId)).data.tutorId == request.auth.uid ||
          get(/databases/$(database)/documents/chats/$(chatId)).data.parentId == request.auth.uid
        );
      }
    }

    // AUDIT LOGS
    match /audit_logs/{logId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'tutor';
      allow delete: if isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'tutor' && resource.data.tutorId == request.auth.uid;
      allow update: if false;
    }
  }
}